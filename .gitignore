# Build artifacts
*.o
*.so
*.dll
*.dylib
*.a
build/
__pycache__/
*.py[cod]
.pytest_cache/
_cffi_*.c

# Reference oracle dumps that are regenerated
reference/*.raw.json

# WASM build output. hephaestus.js IS committed (single-file build, ~300 KB): the hosted
# site is just the tracked web/ tree served as-is (gh-pages branch, no CI, no build
# step), so what deploys is byte-for-byte what was verified locally. Rebuild with
# scripts/build_wasm.sh and re-commit whenever src/ changes; the split .wasm variant
# stays ignored.
web/hephaestus.wasm

# Local demo data (not committed)
web/*.dat
web/*.png
# ...except the open databases the live calculator ships (open data)
!web/FeO-MgO-SiO2-combined.dat
!web/LiCl-KCl.dat
!web/CaO-Al2O3-SiO2.dat

# Database fit scratch (regenerated by the fit scripts)
data/*/_*.dat
data/*/_*.tdb
data/*/_*.log
data/*/_mlip/cif/
data/*/_mlip/*.log
data/*/_mlip/*.json
data/*/_mlip/*.png
data/*/*.png
cef/_*.tdb
cef/__pycache__/

