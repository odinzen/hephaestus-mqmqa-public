 PARAMETER MQSTOI(SALT_LIQUID,MG+2:CL-1)  298.15  1 2 0 0 0; 6000.00 N !

 PARAMETER MQZ(SALT_LIQUID,NA+1,NA+1:CL-1,CL-1)  298.15  6 6 6 6; 6000.00 N !
 PARAMETER MQZ(SALT_LIQUID,K+1,K+1:CL-1,CL-1)    298.15  6 6 6 6; 6000.00 N !
 PARAMETER MQZ(SALT_LIQUID,MG+2,MG+2:CL-1,CL-1)  298.15  6 6 3 3; 6000.00 N !

