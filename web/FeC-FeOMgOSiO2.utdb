$ Unified-dialect demonstration: STEELMAKING in one database.
$
$ Basic steel (Fe-C after Gustafson 1985 on Dinsdale unaries, as in FeC.tdb,
$ with the Inden-Hillert-Jarl magnetic BCC and FCC) together with the open
$ FeO-MgO-SiO2 slag assessment shipped as web/FeO-MgO-SiO2-combined.dat: the
$ MQMQA slag liquid, the olivine and orthopyroxene solid solutions, and the
$ oxide solids. Steel and its slag share iron in one file; no legacy container
$ can hold this pairing. Carried by the uTDB extension statements (:Q phase,
$ MQG/MQZETA/MQSTOI/MQZ/MQX; see docs/UNIFIED_TDB_SPEC.md); the round-trip
$ test asserts both halves agree with their source files at machine precision.
$ CC BY 4.0 like the rest of the data in this repository.
$
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT FE   BCC_A2                    5.5847E+01  4.4890E+03  2.7280E+01 !
 ELEMENT C    GRAPHITE                  1.2011E+01  1.0540E+03  5.7400E+00 !
 ELEMENT MG   HCP_A3                    2.4305E+01  0.0000E+00  0.0000E+00 !
 ELEMENT SI   DIA_A4                    2.8085E+01  0.0000E+00  0.0000E+00 !
 ELEMENT O    GAS_1/2_MOLE_O2           1.5999E+01  0.0000E+00  0.0000E+00 !

 SPECIES FE+2   FE1/+2 !
 SPECIES MG+2   MG1/+2 !
 SPECIES SI+4   SI1/+4 !
 SPECIES O-2    O1/-2 !
 SPECIES FEO    FE1O1 !
 SPECIES MGO    MG1O1 !
 SPECIES SIO2   SI1O2 !

$ ------------------------- Fe-C steel (plain TDB) -------------------------

 FUNCTION GHSERFE  298.15
    +1225.7+124.134*T-23.5143*T*LN(T)
    -4.39752E-3*T**2-5.8927E-8*T**3+77359*T**(-1);            1811.00 Y
    -25383.581+299.31255*T-46*T*LN(T)
    +2.29603E+31*T**(-9);                                     6000.00 N !

 FUNCTION GFELIQ   298.15
    +12040.17-6.55843*T-3.6751551E-21*T**7+GHSERFE#;          1811.00 Y
    -10838.83+291.302*T-46*T*LN(T);                           6000.00 N !

 FUNCTION GFEFCC   298.15
    -236.7+132.416*T-24.6643*T*LN(T)
    -3.75752E-3*T**2-5.8927E-8*T**3+77359*T**(-1);            1811.00 Y
    -27097.396+300.252559*T-46*T*LN(T)
    +2.78854E+31*T**(-9);                                     6000.00 N !

 FUNCTION GHSERCC  298.15
    -17368.441+170.73*T-24.3*T*LN(T)
    -4.723E-4*T**2+2562600*T**(-1)
    -2.643E+8*T**(-2)+1.2E+10*T**(-3);                        6000.00 N !

 FUNCTION GCLIQ    298.15  +117369-24.63*T+GHSERCC#;          6000.00 N !

 TYPE_DEFINITION % SEQ * !
 TYPE_DEFINITION & GES A_P_D BCC_A2 MAGNETIC -1.0 0.4 !
 TYPE_DEFINITION ' GES A_P_D FCC_A1 MAGNETIC -3.0 0.28 !

 PHASE STEEL_LIQUID %  1  1.0 !
 CONSTITUENT STEEL_LIQUID : C,FE : !
 PARAMETER G(STEEL_LIQUID,FE;0)    298.15  +GFELIQ#;          6000.00 N !
 PARAMETER G(STEEL_LIQUID,C;0)     298.15  +GCLIQ#;           6000.00 N !
 PARAMETER G(STEEL_LIQUID,C,FE;0)  298.15  -124320+28.5*T;    6000.00 N !
 PARAMETER G(STEEL_LIQUID,C,FE;1)  298.15  +19300;            6000.00 N !
 PARAMETER G(STEEL_LIQUID,C,FE;2)  298.15  +49260-19*T;       6000.00 N !

 PHASE BCC_A2 %&  2  1.0  3.0 !
 CONSTITUENT BCC_A2 : FE : C,VA : !
