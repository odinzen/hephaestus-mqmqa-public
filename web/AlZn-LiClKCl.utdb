$ Unified-dialect demonstration: an alloy and a molten salt in ONE database.
$
$ This file is ordinary Thermo-Calc-style TDB for the Al-Zn alloy (an Mey 1993
$ on Dinsdale SGTE unaries, as in AlZn.tdb) PLUS the LiCl-KCl MQMQA molten salt
$ carried by the uTDB extension statements (:Q phase, MQG/MQZETA/MQSTOI/MQZ/MQX;
$ see docs/UNIFIED_TDB_SPEC.md). The salt physics is the same open assessment
$ shipped as web/LiCl-KCl.dat; the round-trip test asserts the two containers
$ agree at machine precision. No other format holds both models in one file.
$ CC BY 4.0 like the rest of the data in this repository.
$
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT AL   FCC_A1                    2.6982E+01  4.5773E+03  2.8322E+01 !
 ELEMENT ZN   HCP_A3                    6.5390E+01  5.6567E+03  4.1631E+01 !
 ELEMENT LI   BCC_A2                    6.9400E+00  4.6233E+03  2.9095E+01 !
 ELEMENT K    BCC_A2                    3.9098E+01  7.0883E+03  6.4670E+01 !
 ELEMENT CL   GAS_1/2_MOLE_CL2          3.5453E+01  0.0000E+00  0.0000E+00 !

 SPECIES LI+1  LI1/+1 !
 SPECIES K+1   K1/+1 !
 SPECIES CL-1  CL1/-1 !
 SPECIES LICL  LI1CL1 !
 SPECIES KCL   K1CL1 !

$ ------------------------- Al-Zn alloy (plain TDB) -------------------------

 FUNCTION GHSERAL  298.0
    -7976.15+137.0715*T-24.36720*T*LN(T)
    -1.884662E-3*T**2-0.877664E-6*T**3+74092*T**(-1);          700.00 Y
    -11276.24+223.0269*T-38.58443*T*LN(T)
    +18.531982E-3*T**2-5.764227E-6*T**3+74092*T**(-1);          933.6 Y
    -11277.68+188.6620*T-31.74819*T*LN(T)
    -1234.26E25*T**(-9);                                      2900.00 N !

 FUNCTION GALLIQ   298.0
    +3029.403+125.2307*T-24.36720*T*LN(T)
    -1.884662E-3*T**2-0.877664E-6*T**3
    +74092*T**(-1)+79.401E-21*T**7;                            700.00 Y
    -270.6860+211.1861*T-38.58443*T*LN(T)
    +18.53198E-3*T**2-5.764227E-6*T**3
    +74092*T**(-1)+79.401E-21*T**7;                             933.6 Y
    -795.7090+177.4100*T-31.74819*T*LN(T);                    2900.00 N !

 FUNCTION GALHCP   298.0   +5481-1.8*T+GHSERAL#;              6000.00 N !

 FUNCTION GHSERZN  298.0
    -7285.787+118.4693*T-23.70131*T*LN(T)
    -1.712034E-3*T**2-1.264963E-6*T**3;                         692.7 Y
    -11070.60+172.3449*T-31.38*T*LN(T)
    +4.70657E+26*T**(-9);                                     1700.00 N !

 FUNCTION GZNLIQ   298.14
    +7157.213-10.29299*T-3.5896E-19*T**7+GHSERZN#;              692.7 Y
    +7450.168-10.737066*T-4.7051E+26*T**(-9)+GHSERZN#;        1700.00 N !

 FUNCTION GZNFCC   298.15  +2969.82-1.56968*T+GHSERZN#;       1700.00 N !

 TYPE_DEFINITION % SEQ * !

 PHASE ALLOY_LIQUID %  1  1.0 !
 CONSTITUENT ALLOY_LIQUID : AL,ZN : !
 PARAMETER G(ALLOY_LIQUID,AL;0)     298.15  +GALLIQ#;         2900.00 N !
 PARAMETER G(ALLOY_LIQUID,ZN;0)     298.15  +GZNLIQ#;         1700.00 N !
 PARAMETER G(ALLOY_LIQUID,AL,ZN;0)  298.15  +10465.5-3.39259*T; 6000.00 N !

 PHASE FCC_A1 %  1  1.0 !
 CONSTITUENT FCC_A1 : AL,ZN : !
 PARAMETER G(FCC_A1,AL;0)     298.15  +GHSERAL#;              2900.00 N !
 PARAMETER G(FCC_A1,ZN;0)     298.15  +GZNFCC#;               1700.00 N !
 PARAMETER G(FCC_A1,AL,ZN;0)  298.15  +7297.5+0.47512*T;      6000.00 N !
 PARAMETER G(FCC_A1,AL,ZN;1)  298.15  +6612.9-4.5911*T;       6000.00 N !
 PARAMETER G(FCC_A1,AL,ZN;2)  298.15  -3097.2+3.30635*T;      6000.00 N !

 PHASE HCP_A3 %  1  1.0 !
 CONSTITUENT HCP_A3 : AL,ZN : !
 PARAMETER G(HCP_A3,AL;0)     298.15  +GALHCP#;               2900.00 N !
 PARAMETER G(HCP_A3,ZN;0)     298.15  +GHSERZN#;              1700.00 N !
 PARAMETER G(HCP_A3,AL,ZN;0)  298.15  +18821.0-8.95255*T;     6000.00 N !
 PARAMETER G(HCP_A3,AL,ZN;3)  298.15  -702.8;                 6000.00 N !

$ --------------- LiCl-KCl molten salt (uTDB :Q extension) ------------------
$ Same open assessment as web/LiCl-KCl.dat (TKV/Barin endmembers, measured
$ eutectic); per-pair Gibbs on the (1, T, T lnT, T^2, T^3, 1/T) basis.

 PHASE SALT_LIQUID:Q %  2  1.0  1.0 !
 CONSTITUENT SALT_LIQUID:Q : LI+1,K+1 : CL-1 : !

 PARAMETER MQG(SALT_LIQUID,LI+1:CL-1;0)  298.15
    -403050.8975729+217.4276616860*T-43.60240*T*LN(T)
    -1.035660500000E-2*T**2+77550*T**(-1);                    6000.00 N !
 PARAMETER MQG(SALT_LIQUID,K+1:CL-1;0)   298.15
    -422433.4810225+169.4367694345*T-40.52540*T*LN(T)
    -1.249404000000E-2*T**2-149195*T**(-1);                   6000.00 N !

 PARAMETER MQZETA(SALT_LIQUID,LI+1:CL-1)  298.15  1.3774438; 6000.00 N !
 PARAMETER MQZETA(SALT_LIQUID,K+1:CL-1)   298.15  1.3774438; 6000.00 N !
 PARAMETER MQSTOI(SALT_LIQUID,LI+1:CL-1)  298.15  1 1 0 0 0; 6000.00 N !
 PARAMETER MQSTOI(SALT_LIQUID,K+1:CL-1)   298.15  1 1 0 0 0; 6000.00 N !

 PARAMETER MQZ(SALT_LIQUID,LI+1,LI+1:CL-1,CL-1)  298.15  6 6 6 6; 6000.00 N !
 PARAMETER MQZ(SALT_LIQUID,K+1,K+1:CL-1,CL-1)    298.15  6 6 6 6; 6000.00 N !

 PARAMETER MQXQ(SALT_LIQUID,LI+1,K+1:CL-1,CL-1;0,0)  298.15
    -9467.28+7.92*T;                                          6000.00 N !
 PARAMETER MQXQ(SALT_LIQUID,LI+1,K+1:CL-1,CL-1;1,0)  298.15
    -1112.46;                                                 6000.00 N !

 PHASE LICL_SOLID %  1  1.0 !
 CONSTITUENT LICL_SOLID : LICL : !
 PARAMETER G(LICL_SOLID,LICL;0)  298.15
    -422798.8975729+239.7923275977*T-43.60240*T*LN(T)
    -1.035660500000E-2*T**2+77550*T**(-1);                    6000.00 N !

 PHASE KCL_SOLID %  1  1.0 !
 CONSTITUENT KCL_SOLID : KCL : !
 PARAMETER G(KCL_SOLID,KCL;0)   298.15
    -448750.4810225+194.6446238406*T-40.52540*T*LN(T)
    -1.249404000000E-2*T**2-149195*T**(-1);                   6000.00 N !
